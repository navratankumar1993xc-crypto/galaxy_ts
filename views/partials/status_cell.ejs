<%
  // The reference draws the status cell as an inline 40px SVG badge that links
  // to the toggle endpoint: green tick when open, grey cross when closed.
  // Final Rule: the controller is the highest authority and can never be
  // closed, disabled or blocked, so its badge is a static green tick with no
  // toggle link — nobody (not even itself) can click it closed.
  var isController = user.role === 'controller';
  var closed = !isController && user.status !== 'active';
%>
<% if (isController) { %>
<span style="display:inline-block;" title="Controller — highest authority, always active">
<% } else { %>
<a href="/status_update?u_id=<%= user.id %>" style="display:inline-block;" title="Click to <%= closed ? 'open' : 'close' %> this panel">
<% } %>
<% if (closed) { %>
  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40">
    <defs>
      <radialGradient id="gradDeactive<%= user.id %>" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#E0E0E0"/>
        <stop offset="100%" stop-color="#B0B0B0"/>
      </radialGradient>
    </defs>
    <circle cx="20" cy="20" r="18" fill="url(#gradDeactive<%= user.id %>)" stroke="#999" stroke-width="2"/>
    <line x1="14" y1="14" x2="26" y2="26" stroke="white" stroke-width="3" stroke-linecap="round"/>
    <line x1="26" y1="14" x2="14" y2="26" stroke="white" stroke-width="3" stroke-linecap="round"/>
  </svg>
<% } else { %>
  <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 40 40">
    <defs>
      <radialGradient id="gradActive<%= user.id %>" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#7ED957"/>
        <stop offset="100%" stop-color="#4CAF50"/>
      </radialGradient>
    </defs>
    <circle cx="20" cy="20" r="18" fill="url(#gradActive<%= user.id %>)" stroke="#3E8E41" stroke-width="2"/>
    <path d="M12 20 L18 26 L28 14" stroke="white" stroke-width="3" fill="none" stroke-linecap="round"/>
  </svg>
<% } %>
<% if (isController) { %>
</span>
<% } else { %>
</a>
<% } %>
