<nav class="main-header navbar navbar-expand navbar-white navbar-light">
  <div class="container-fluid">
    <!-- Left navbar links -->
    <ul class="navbar-nav">
      <li class="nav-item">
        <a class="nav-link" data-widget="pushmenu" href="#" role="button" aria-label="Toggle sidebar">
          <i class="fas fa-bars"></i>
        </a>
      </li>
    </ul>

    <!-- Ticker -->
    <div style="flex-grow: 1; margin: 0 10px; overflow: hidden; background: rgba(0,0,0,0.85); border-radius: 6px; border: 1px solid #2e7d32; padding: 0 10px; height: 35px; display: flex; align-items: center; box-shadow: 0 2px 8px rgba(46,125,50,0.2);">
      <marquee behavior="scroll" direction="left" scrollamount="4" style="color: #fff; font-weight: 700; font-size: 14px; line-height: 35px; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
        <% if (typeof tickerNews !== 'undefined' && tickerNews) { %>
          📢 <%= tickerNews.body %>
        <% } else { %>
          <%= brand.ticker(roleName) %>
        <% } %>
      </marquee>
    </div>

    <!-- Right navbar links -->
    <ul class="navbar-nav ml-auto align-items-center">
      <% /* Due is what a panel owes its parent. The controller sits at the top of
            the chain and has no parent, so it owes nothing — no Due badge for it.
            While the controller is inside another panel via Direct Login, me.role
            is the target's, so that panel's own due shows as normal. */ %>
      <% if (me.role !== 'controller') { %>
      <li class="nav-item d-none d-sm-flex align-items-center">
        <div style="background: linear-gradient(135deg, #e74c3c, #c0392b); border: 2px solid #fff; border-radius: 50px; padding: 5px 15px; margin-right: 15px; display: flex; align-items: center; gap: 10px; box-shadow: 0 4px 10px rgba(231, 76, 60, 0.4); white-space: nowrap; color: #fff; flex-shrink: 0; min-width: max-content;">
          <div style="font-weight: 900; font-size: 1.1rem; flex-shrink: 0; min-width: max-content;">
            💸 Due: <%= inr(me.due) %>
          </div>
        </div>
      </li>
      <% } %>

      <li class="nav-item dropdown">
        <a class="nav-link" data-toggle="dropdown" href="#" aria-haspopup="true" aria-expanded="false">
          <i class="far fa-user mr-1"></i>
          <%= me.username %>
        </a>
        <div class="dropdown-menu dropdown-menu-right">
          <span class="dropdown-item-text">
            Role: <b><%= roleName %></b>
          </span>
          <% /* The controller changes its own password from here, not from the
                users table — it is the highest authority and has no parent to
                reset it. The modal below posts to the same /status_update
                endpoint with the controller's own id. */ %>
          <% if (me.role === 'controller') { %>
            <a href="#" class="dropdown-item" data-toggle="modal" data-target="#modal-self-password">
              <i class="fas fa-key mr-2"></i> Change Password
            </a>
          <% } %>
          <div class="dropdown-divider"></div>
          <a href="/logout" class="dropdown-item text-danger">
            <i class="fas fa-sign-out-alt mr-2"></i> Logout
          </a>
        </div>
      </li>
    </ul>
  </div>
</nav>

<% if (impersonating) { %>
<!-- Direct Login banner: the controller is inside another panel. Every page
     shows this strip so the way back is never more than one click away. -->
<div style="background: linear-gradient(135deg, #f59e0b, #b45309); color: #fff; padding: 10px 18px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; box-shadow: 0 2px 8px rgba(180,83,9,.35);">
  <div style="font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 8px;">
    <i class="fas fa-user-secret"></i>
    <span><%= boldText('Direct Login') %>: you are inside <strong><%= me.username %></strong>'s panel (<%= roleName %>). Everything shows as this user.</span>
  </div>
  <form action="/back_to_controller" method="post" style="margin: 0;">
    <button type="submit" class="btn font-weight-bold" style="background: #fff !important; color: #b45309 !important; border: 0; border-radius: 8px; padding: 7px 16px; box-shadow: 0 2px 6px rgba(0,0,0,.2);">
      <i class="fas fa-arrow-left mr-1"></i> <%= boldText('Back to Controller') %>
    </button>
  </form>
</div>
<% } %>

<% if (me.role === 'controller') { %>
<!-- Controller's own password change, opened from the top-right user dropdown.
     It posts to the same /status_update reset endpoint with the controller's
     own id; no other login owns the controller, so nobody else can use it. -->
<div class="modal fade" id="modal-self-password" tabindex="-1" role="dialog" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h4 class="modal-title"><%= boldText('Change Password') %></h4>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <form action="/status_update" method="post">
        <div class="modal-body">
          <p class="text-muted" style="margin-bottom: 12px;"><%= boldText('Set a new password for your controller login') %> (<%= me.username %>).</p>
          <input type="text" name="password" class="form-control" placeholder="<%= boldText('Enter New Password') %>" required>
          <input type="hidden" name="id" value="<%= me.id %>">
        </div>
        <div class="modal-footer justify-content-between">
          <button type="button" class="btn btn-default" data-dismiss="modal"><%= boldText('Close') %></button>
          <button type="submit" class="btn btn-warning"><%= boldText('Reset') %></button>
        </div>
      </form>
    </div>
  </div>
</div>
<% } %>
