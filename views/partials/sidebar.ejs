<aside class="main-sidebar sidebar-light-primary elevation-4" style="background: var(--bg) !important; border-right: 1px solid var(--line) !important;">
  <!-- Brand Logo -->
  <a href="/home" class="brand-link" style="background: linear-gradient(110deg, #9a3412 0%, #d97706 46%, #166534 100%) !important; border-bottom: 0; padding: 10px 15px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(0,0,0,0.22);">
    <img src="<%= brand.logo %>" alt="<%= brand.nameUpper %> Logo" style="width: 180px; max-width: 100%; height: auto; object-fit: contain; flex-shrink: 0; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.35));">
  </a>

  <div class="sidebar">
    <!-- Sidebar user panel -->
    <div class="user-panel mt-4 pb-4 mb-4 d-flex align-items-center" style="border-bottom: 1px solid var(--line) !important; padding: 0 10px; width: 100%; overflow: hidden;">
      <div class="image" style="padding-left: 5px;">
        <img src="/img/user.svg" alt="User Image" style="width: 50px; height: 50px; border-radius: 50%; border: 2px solid #fff; box-shadow: 0 0 12px rgba(255, 111, 0, 0.6) !important; object-fit: cover; flex-shrink: 0;">
      </div>
      <div class="info" style="margin-left: 15px; line-height: 1.2; overflow: hidden; flex-grow: 1;">
        <a href="/home" class="d-block" style="font-size: 1.15rem; font-weight: 800; color: #1e293b !important; text-transform: uppercase; letter-spacing: 0.5px;" title="<%= me.username %>">
          <%= me.username %>
        </a>
        <span style="font-size: 0.72rem; color: #ff6f00 !important; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; margin-top: 4px; display: inline-flex; align-items: center; gap: 6px;">
          <span style="width: 8px; height: 8px; background: #ff6f00; border-radius: 50%; display: inline-block; flex-shrink: 0;"></span>
          <%= me.role %>
        </span>
      </div>
    </div>

    <!-- Sidebar Menu -->
    <nav class="mt-2">
      <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
        <% menu.forEach(function (item) { %>
          <% if (item.switchItem) { %>
            <li class="nav-item">
              <% // The stored demo length, or 2 when the setting is missing/dirty. %>
              <% var demoSaved = parseInt(settings.demo_days, 10); if (!demoSaved || demoSaved < 1 || demoSaved > 3650) demoSaved = 2; %>
              <% // One form for both controls. The switch line keeps the reference
                 // markup (hidden allow_demo=0 first, then the checkbox's 1) and the
                 // line under it carries the length the same flip saves. %>
              <form method="post" action="/toggle_demo" id="demoToggleForm" class="mb-0">
                <input type="hidden" name="allow_demo" value="0">
                <div class="nav-link d-flex align-items-center justify-content-between">
                  <div class="d-flex align-items-center">
                    <i class="nav-icon fas fa-toggle-on"></i>
                    <p class="mb-0 ml-2">Allow demo key</p>
                  </div>
                  <div class="custom-control custom-switch custom-switch-on-success custom-switch-off-danger">
                    <input type="checkbox" class="custom-control-input" id="allow_demo_switch" name="allow_demo" value="1"
                      <%= settings.allow_demo === '1' ? 'checked' : '' %>>
                    <label class="custom-control-label mb-0" for="allow_demo_switch"></label>
                  </div>
                </div>
                <div class="nav-link pt-0 pb-2">
                  <div class="demo-days-row">
                    <span class="demo-days-caption"><i class="fas fa-calendar-alt"></i> Demo days</span>
                    <input type="number" name="days" id="demo_days_input" min="1" max="3650" step="1"
                      value="<%= demoSaved %>" data-fallback="<%= demoSaved %>" inputmode="numeric"
                      class="demo-days-box" placeholder="days">
                    <button type="submit" class="btn btn-sm demo-days-save" title="Save the demo length">
                      <i class="fas fa-check"></i> Save
                    </button>
                  </div>
                  <div class="demo-days-hint" id="demo_days_hint" style="display: none;">
                    <i class="fas fa-exclamation-circle"></i> Type the days, then the switch turns on.
                  </div>
                </div>
              </form>
              <script>
                document.addEventListener('DOMContentLoaded', function () {
                  var form = document.getElementById('demoToggleForm');
                  if (!form) return;
                  var sw = document.getElementById('allow_demo_switch');
                  var days = document.getElementById('demo_days_input');
                  var hint = document.getElementById('demo_days_hint');
                  var ok = function () {
                    var n = parseInt(days.value, 10);
                    return Number.isInteger(n) && n >= 1 && n <= 3650;
                  };
                  var say = function (on) {
                    if (hint) hint.style.display = on ? 'block' : 'none';
                    days.classList.toggle('is-invalid', on);
                    if (on) days.focus();
                  };
                  // Switching ON asks for the length first: with nothing usable in the
                  // box the switch flips back and the row says why. Switching OFF needs
                  // no number, so it posts straight away.
                  sw.addEventListener('change', function () {
                    if (sw.checked && !ok()) { sw.checked = false; say(true); return; }
                    say(false);
                    form.submit();
                  });
                  // A number typed while demo is on saves as soon as it is usable.
                  days.addEventListener('change', function () { if (sw.checked && ok()) form.submit(); });
                  days.addEventListener('input', function () { if (ok()) say(false); });
                  days.addEventListener('keydown', function (e) { if (e.key === 'Enter') e.preventDefault(); });
                  form.addEventListener('submit', function (e) {
                    if (sw.checked && !ok()) { e.preventDefault(); sw.checked = false; say(true); }
                  });
                });
              </script>
            </li>
          <% } else if (item.tree) { %>
            <li class="nav-item has-treeview">
              <a href="#" class="nav-link<%= treeActive(item) ? ' active' : '' %>">
                <i class="nav-icon <%= item.icon %>"></i>
                <p>
                  <%= item.label %>
                  <i class="right fas fa-angle-left"></i>
                </p>
              </a>
              <ul class="nav nav-treeview" style="padding-left: 15px;">
                <% item.tree.forEach(function (child) { %>
                  <li class="nav-item">
                    <a href="<%= child.href %>" class="nav-link<%= child.match === path ? ' active' : '' %>">
                      <i class="nav-icon <%= child.icon %>"></i>
                      <p><%= child.label %></p>
                    </a>
                  </li>
                <% }) %>
              </ul>
            </li>
          <% } else { %>
            <li class="nav-item">
              <a href="<%= item.href %>" class="nav-link<%= item.match === path ? ' active' : '' %>">
                <i class="nav-icon <%= item.icon %>"></i>
                <p>
                  <%= item.label %>
                  <% if (item.badge) { %>
                    <span class="right badge badge-danger"<%= item.badgeAccent ? ' style="background-color: var(--accent) !important; color: #fff !important;"' : '' %>><%= item.badge %></span>
                  <% } %>
                </p>
              </a>
            </li>
          <% } %>
        <% }) %>
      </ul>
    </nav>
  </div>
</aside>
