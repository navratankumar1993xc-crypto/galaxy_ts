<%- include('../partials/head') %>

<% /* The receipt is a standalone print-friendly document: no sidebar, no
      topbar. It names both parties, the amount and both dates, exactly as the
      ledger stores them. Only the sender, the receiver and the controller
      reach this page (the route guards it). */ %>
<div class="content-wrapper" style="margin-left:0;">
  <section class="content">
    <div class="container-fluid" style="max-width:760px;">
      <%- include('../partials/flash') %>

      <div class="dash-card" id="receipt-doc">
        <div class="dash-card-head d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <div class="dash-ico mr-2"><i class="fas fa-receipt"></i></div>
            <div>
              <div class="dash-title"><%= boldText('Payment Receipt') %> #<%= p.id %></div>
              <div class="dash-sub"><%= brand %> &mdash; <%= boldText('Payment Receive Hierarchy') %></div>
            </div>
          </div>
          <% if (p.kind === 'due') { %>
            <span class="badge badge-<%= p.status === 'Success' ? 'success' : 'warning' %>">
              <%= boldText(p.status === 'Success' ? 'Paid' : 'Due') %>
            </span>
          <% } else { %>
            <span class="badge badge-<%= p.status === 'Success' ? 'success' : (p.status === 'Pending' ? 'warning' : 'danger') %>">
              <%= boldText(p.status) %>
            </span>
          <% } %>
        </div>
        <div class="dash-card-body">
          <table class="table table-bordered mb-0" style="background:var(--card);">
            <tbody>
              <tr>
                <th style="width:38%;"><%= boldText('Paid By (Sender)') %></th>
                <td><b><%= p.sender %></b> <span class="text-muted">(<%= (ROLES[p.sender_role] || { label: p.sender_role }).label %>)</span></td>
              </tr>
              <tr>
                <th><%= boldText('Received By (Receiver)') %></th>
                <td><b><%= p.receiver %></b> <span class="text-muted">(<%= (ROLES[p.receiver_role] || { label: p.receiver_role }).label %>)</span></td>
              </tr>
              <tr>
                <th><%= boldText('Amount') %></th>
                <td><b style="font-size:18px; color:var(--danger);"><%= inr(p.amount) %></b></td>
              </tr>
              <tr>
                <th><%= boldText('Send Date') %></th>
                <td><%= p.send_date %></td>
              </tr>
              <tr>
                <th><%= boldText('Received Date') %></th>
                <td>
                  <% if (p.received_date) { %>
                    <%= p.received_date %>
                  <% } else { %>
                    <span class="text-muted"><%= boldText('Not received yet') %></span>
                  <% } %>
                </td>
              </tr>
              <tr>
                <th><%= boldText('Key') %></th>
                <td>
                  <% if (p.key_name) { %>
                    <%= p.key_name %>
                    <% if (p.is_renew) { %><span class="badge badge-info"><%= boldText('Renew') %></span><% } %>
                  <% } else { %>
                    <span class="text-muted">&mdash;</span>
                  <% } %>
                </td>
              </tr>
              <tr>
                <th><%= boldText('Payment Type') %></th>
                <td>
                  <% if (p.kind === 'due') { %>
                    <%= boldText(p.is_renew ? 'Renewal Key Due' : 'Key Due') %>
                  <% } else { %>
                    <%= boldText('Direct Payment') %>
                  <% } %>
                </td>
              </tr>
            </tbody>
          </table>
          <p class="text-muted mt-3 mb-0" style="font-size:12px; font-weight:700;">
            <i class="fas fa-sitemap mr-1"></i>
            A payment is received only by the payer's direct upline: Seller &rarr; Super Seller &rarr; Admin &rarr; Master &rarr; Super Master &rarr; Developer &rarr; Controller.
          </p>
        </div>
      </div>

      <div class="mt-3 d-flex no-print" style="gap:10px;">
        <button type="button" class="btn btn-pro" onclick="window.print()">
          <i class="fas fa-print mr-1"></i> <%= boldText('Print') %>
        </button>
        <a href="/transaction" class="btn btn-secondary">
          <i class="fas fa-arrow-left mr-1"></i> <%= boldText('Back') %>
        </a>
      </div>
    </div>
  </section>
</div>

<style>
  /* This page carries no sidebar or topbar, so printing it yields the receipt
     alone; the buttons drop out and the card keeps a plain paper border. */
  @media print {
    .no-print { display: none !important; }
    body { background: #fff !important; }
    .dash-card { box-shadow: none !important; border: 1px solid #000 !important; }
  }
</style>

<%- include('../partials/foot', { tables: false }) %>