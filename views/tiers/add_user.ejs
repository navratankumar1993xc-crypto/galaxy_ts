<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<div class="content-wrapper">
  <%- include('../partials/pagehead') %>

  <section class="content">
    <%- include('../partials/flash') %>
    <div class="container-fluid">

      <div class="dash-card">
        <div class="dash-card-head d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <div class="dash-ico mr-2"><i class="fas fa-user-shield"></i></div>
            <div>
              <div class="dash-title">Identity Management Console</div>
              <div class="dash-sub">Manage and create child admin/seller panels</div>
            </div>
          </div>
          <a href="/home" class="btn btn-exit" style="background: #475569 !important; color: #fff !important; border-radius: 8px; font-weight: 700; padding: 8px 18px; font-size: 0.85rem;">
            <i class="fas fa-sign-out-alt mr-1"></i> Exit Module
          </a>
        </div>

        <div class="dash-card-body">
          <% /* The reference's quickForm posts to the page itself. */ %>
          <form id="quickForm" method="post" action="">
            <h4 class="mb-4" style="font-weight: 800; color: var(--ink); border-bottom: 1.5px solid var(--line); padding-bottom: 12px; text-transform: uppercase; letter-spacing: 0.5px; font-size: 1.05rem; display: flex; align-items: center; gap: 8px;">
              <i class="fas fa-user-plus" style="color: var(--accent);"></i>
              CREATE <%= nextRoleLabel %> Panel
            </h4>

            <div class="row">
              <div class="col-12 col-md-6 mb-4">
                <div class="form-group mb-0">
                  <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">User Name</label>
                  <div class="f-control">
                    <i class="fas fa-user mr-3" style="color: var(--muted); font-size: 15px;"></i>
                    <input type="text" name="user_name" id="user_name1" placeholder="Enter User Name" required>
                  </div>
                </div>
              </div>

              <div class="col-12 col-md-6 mb-4">
                <div class="form-group mb-0">
                  <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">Password</label>
                  <div class="f-control">
                    <i class="fas fa-lock mr-3" style="color: var(--muted); font-size: 15px;"></i>
                    <input type="password" name="password" id="password" placeholder="Enter Password" required>
                  </div>
                </div>
              </div>
            </div>

            <input type="hidden" value="<%= nextRole %>" name="role">

            <div class="mt-2">
              <button type="submit" class="btn btn-pro">
                <i class="fas fa-user-plus mr-1"></i> CREATE ACCOUNT
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </section>
</div>

<%- include('../partials/foot') %>
