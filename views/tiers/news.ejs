<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<div class="content-wrapper">
  <%- include('../partials/pagehead') %>

  <section class="content">
    <div class="container-fluid">
      <%- include('../partials/flash') %>

      <% if (targets.length) { %>
        <div class="dash-card mb-4">
          <div class="dash-card-head d-flex align-items-center justify-content-between">
            <div class="d-flex align-items-center">
              <div class="dash-ico mr-2"><i class="fas fa-satellite-dish"></i></div>
              <div>
                <div class="dash-title">All panel news send</div>
                <div class="dash-sub">Personal news can be sent by any panel and appears across all panels. All Panels is controller-only.</div>
              </div>
            </div>
            <a href="/home" class="btn btn-secondary" style="background: #475569 !important; color: #fff !important; border-radius: 8px; font-weight: 700; padding: 8px 18px; font-size: 0.85rem;">
              <i class="fas fa-sign-out-alt mr-1"></i> Exit Module
            </a>
          </div>
          <div class="dash-card-body">
            <form action="" method="POST">
              <div class="row">
                <div class="col-lg-8 mb-4 mb-lg-0">
                  <div class="form-group mb-0">
                    <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">Content box</label>
                    <textarea class="form-control" name="news" placeholder="Compose message or content here..." style="min-height: 180px; resize: vertical;" required></textarea>
                  </div>
                </div>
                <div class="col-lg-4">
                  <div class="form-group mb-4">
                    <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">Select panel</label>
                    <div class="f-control" style="height: 50px !important;">
                      <select name="role" required>
                        <% targets.forEach(function (t) { %>
                          <option value="<%= t.value %>"><%= t.label %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <div class="mt-4">
                    <button type="submit" class="btn btn-pro w-100" style="height: 50px; font-size: 14px;">
                      <i class="fas fa-paper-plane mr-1"></i> Send news panel
                    </button>
                  </div>
                </div>
              </div>
            </form>
          </div>
        </div>
      <% } %>

      <div class="dash-card">
        <div class="dash-card-head d-flex align-items-center">
          <div class="dash-ico mr-2"><i class="fas fa-history" style="color: #60a5fa !important;"></i></div>
          <div>
            <div class="dash-title">News list</div>
            <div class="dash-sub">Log of all active published broadcasts and their target audiences</div>
          </div>
        </div>
        <div class="dash-card-body">
          <div class="table-responsive">
            <table class="table table-bordered table-striped mb-0">
              <thead>
                <tr>
                  <th>Content Details</th>
                  <th style="width: 200px;">Scope</th>
                  <th style="width: 100px; text-align: center;">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (n) { %>
                  <tr>
                    <td>
                      <div style="font-weight: 600; color: var(--ink);">
                        <%= n.body %>                      </div>
                    </td>
                    <td>
                      <span class="badge badge-info py-2 px-3" style="font-size: 0.78rem; font-weight: 800; background: rgba(59, 130, 246, 0.15) !important; color: #1d4ed8 !important; border-radius: 6px; border: none !important; text-transform: uppercase;">
                        <i class="fas fa-users mr-1"></i> <%= n.scope %>                      </span>
                    </td>
                    <td class="text-center">
                      <% /* Final Delete Permission Rule: only the controller may
                             delete a broadcast; no tier gets the control, even
                             for news it sent itself. */ %>
                      <% if (me.role === 'controller') { %>
                        <a href="/status_update?n_id=<%= n.id %>"
                           class="btn btn-danger btn-sm"
                           style="background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; border: 0 !important; font-weight: 800; border-radius: 6px; padding: 6px 12px;"
                           onclick="return confirm('Confirm deletion of this broadcast record?')">
                          <i class="fas fa-trash-alt"></i>
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
                <% if (!rows.length) { %>
                  <tr><td colspan="3" class="text-center text-muted" style="padding: 24px;">No broadcasts yet.</td></tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/foot') %>
