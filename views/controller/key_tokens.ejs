<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<div class="content-wrapper">
  <%- include('../partials/pagehead') %>

  <section class="content">
    <div class="container-fluid">
      <%- include('../partials/flash') %>

      <div class="dash-card mb-4">
        <div class="dash-card-head d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <div class="dash-ico mr-2"><i class="fas fa-key"></i></div>
            <div>
              <div class="dash-title">Key Tokens</div>
              <div class="dash-sub">Har key ke App / Beta token pool — software GET /api/tokens se ek baar fetch karke local save karta hai</div>
            </div>
          </div>
          <a href="/home" class="btn btn-secondary" style="background: #475569 !important; color: #fff !important; border-radius: 8px; font-weight: 700; padding: 8px 18px; font-size: 0.85rem;">
            <i class="fas fa-sign-out-alt mr-1"></i> Exit Module
          </a>
        </div>
        <div class="dash-card-body">
          <div class="alert alert-info mb-4" style="background: rgba(59, 130, 246, 0.05); border: 1px solid var(--accent); color: var(--ink); border-radius: 8px; font-weight: 600; font-size: 13.5px; padding: 12px 18px; line-height: 1.6;">
            <i class="fas fa-info-circle mr-1" style="color: var(--accent);"></i>
            Token yahan paste karke <b>Push</b> dabao (ya bahar se <code>POST /api/tokens</code>). Software <b>GET TOKEN SERVER 1</b> / <b>GET BETA TOKEN</b> par pending tokens ek baar leta hai aur
            <code>Versions_App.dll</code> / <code>Versions_Beta.dll</code> mein save karta hai — jab tak user Clear Old Tokens na kare, wahi token use hote hain.
          </div>

          <form method="post" action="/key_tokens" class="mb-4">
            <div class="form-row">
              <div class="form-group col-md-4">
                <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.8rem; text-transform: uppercase;">Key</label>
                <select name="key_id" class="form-control" required>
                  <% rows.forEach(function (r) { %>
                    <option value="<%= r.key_id %>"><%= r.key_name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group col-md-3">
                <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.8rem; text-transform: uppercase;">Type</label>
                <select name="type" class="form-control">
                  <option value="app">APP (Server 1)</option>
                  <option value="beta">BETA</option>
                </select>
              </div>
              <div class="form-group col-md-5">
                <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.8rem; text-transform: uppercase;">Tokens (ek per line)</label>
                <textarea name="tokens" class="form-control" rows="3" placeholder="token line 1&#10;token line 2" required></textarea>
              </div>
            </div>
            <button type="submit" class="btn btn-pro" style="font-weight: 800; border-radius: 6px; padding: 8px 18px;">
              <i class="fas fa-upload mr-1"></i> Push Tokens
            </button>
          </form>

          <% if (!rows.length) { %>
            <div class="alert alert-warning mb-0" style="border-radius: 8px; font-weight: 600;">
              <i class="fas fa-exclamation-triangle mr-1"></i> Abhi koi key nahi hai. Pehle /all_key se key generate karo.
            </div>
          <% } else { %>
          <div class="table-responsive">
            <table class="table table-bordered table-striped mb-0 align-middle">
              <thead>
                <tr>
                  <th>Key</th>
                  <th style="width: 180px; text-align: center;">Pending APP</th>
                  <th style="width: 180px; text-align: center;">Pending BETA</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (row) { %>
                  <tr>
                    <td><b style="font-size: 14px; color: var(--ink);"><%= row.key_name %></b></td>
                    <td class="text-center"><span class="badge badge-success" style="border-radius: 6px; font-weight: 800; font-size: 13px;"><%= row.app || 0 %></span></td>
                    <td class="text-center"><span class="badge badge-info" style="border-radius: 6px; font-weight: 800; font-size: 13px;"><%= row.beta || 0 %></span></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/foot') %>