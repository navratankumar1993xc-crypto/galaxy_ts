<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<div class="content-wrapper">
  <%- include('../partials/pagehead') %>

  <section class="content">
    <div class="container-fluid">
      <%- include('../partials/flash') %>

      <div class="dash-card">
        <div class="dash-card-head d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <div class="dash-ico mr-2"><i class="fas fa-ticket-alt"></i></div>
            <div>
              <div class="dash-title">Today Tickets</div>
              <div class="dash-sub">Showing only today's records from tickets3</div>
            </div>
          </div>
        </div>
        <div class="dash-card-body">
          <div class="table-responsive">
            <table id="example1" class="table table-bordered table-striped">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Src Destination</th>
                  <th>Train</th>
                  <th>Pay Mode</th>
                  <th>MAC ID</th>
                                    <th>Key ID</th>
                                  <th>IP Address</th>
                  <th>TDate</th>
                  <th>PNR</th>
                  <th>IMG</th>
                </tr>
              </thead>
              <tbody>
                <% rows.forEach(function (t) { %>
                  <tr>
                    <td><%= t.id %></td>
                    <td><%= t.src %> &rarr; <%= t.dest %></td>
                    <td><%= t.train %></td>
                    <td><%= t.pay_mode %></td>
                    <td><%= t.mac %></td>
                    <td><%= t.key_id %></td>
                    <td><%= t.ip %></td>
                    <td><%= t.tdate %></td>
                    <td><%= t.pnr %></td>
                    <td>
                      <% if (t.img) { %>
                        <a href="/uploads/<%= t.img %>" target="_blank" rel="noopener">
                          <img src="/uploads/<%= t.img %>" alt="" style="height: 34px; border-radius: 4px;">
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/foot', { tables: true }) %>
