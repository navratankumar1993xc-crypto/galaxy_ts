<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<div class="content-wrapper">
  <%- include('../partials/pagehead') %>

  <section class="content">
    <div class="container-fluid">
      <%- include('../partials/flash') %>

      <div class="dash-card mb-4">
        <div class="dash-card-head d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <div class="dash-ico mr-2"><i class="fas fa-link"></i></div>
            <div>
              <div class="dash-title"><%= boldText('Link Management') %></div>
              <div class="dash-sub">These links power the download buttons on the website login page</div>
            </div>
          </div>
          <a href="/home" class="btn btn-secondary" style="background: #475569 !important; color: #fff !important; border-radius: 8px; font-weight: 700; padding: 8px 18px; font-size: 0.85rem;">
            <i class="fas fa-sign-out-alt mr-1"></i> Exit Module
          </a>
        </div>
        <div class="dash-card-body">
          <form method="post" action="/link_management">
            <% links.forEach(function (l) { %>
              <div class="form-group mb-4">
                <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">
                  <i class="<%= l.icon %> mr-2"></i><%= boldText(l.label) %>
                </label>
                <div class="f-control">
                  <i class="fas fa-link mr-3" style="color: var(--muted); font-size: 15px;"></i>
                  <input type="text" name="<%= l.key %>" value="<%= l.value %>" placeholder="https://... (empty = button goes nowhere)">
                </div>
                <small class="form-text text-muted" style="margin-top: 8px; font-size: 12px; font-weight: 600; color: var(--muted) !important;"><%= l.hint %></small>
              </div>
            <% }) %>
            <div class="mt-2">
              <button type="submit" class="btn btn-pro">
                <i class="fas fa-save mr-1"></i> <%= boldText('Save / Update') %>
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </section>
</div>

<%- include('../partials/foot') %>