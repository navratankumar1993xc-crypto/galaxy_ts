<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<div class="content-wrapper">
  <%- include('../partials/pagehead') %>

  <section class="content">
    <div class="container-fluid">
      <%- include('../partials/flash') %>

      <!-- ===== SET AMOUNT AND PANEL CLOSE TIMING LISTS CARD ===== -->
      <div class="dash-card mb-4">
        <div class="dash-card-head d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <div class="dash-ico mr-2"><i class="fas fa-tags"></i></div>
            <div>
              <div class="dash-title">Set Amount and Panel Close Timing Lists</div>
              <div class="dash-sub">Configure role-based rates and daily auto deactivation hours</div>
            </div>
          </div>
          <a href="/home" class="btn btn-secondary" style="background: #475569 !important; color: #fff !important; border-radius: 8px; font-weight: 700; padding: 8px 18px; font-size: 0.85rem;">
            <i class="fas fa-sign-out-alt mr-1"></i> Exit Module
          </a>
        </div>
        <div class="dash-card-body">
          <form id="quickForm" method="post" action="">
            <div class="row">
              <div class="col-md-4 mb-4">
                <div class="form-group mb-0">
                  <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">Price Amount</label>
                  <div class="f-control">
                    <i class="fas fa-rupee-sign mr-3" style="color: var(--muted); font-size: 15px;"></i>
                    <input type="number" name="price" placeholder="Enter Price" min="0" required>
                  </div>
                </div>
              </div>
              <div class="col-md-4 mb-4">
                <div class="form-group mb-0">
                  <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">Target Role</label>
                  <div class="f-control">
                    <i class="fas fa-user-tie mr-3" style="color: var(--muted); font-size: 15px;"></i>
                    <select name="role" required>
                      <% ROLE_ORDER.forEach(function (r) { %>
                        <option value="<%= r %>"><%= ROLES[r].label %></option>
                      <% }) %>
                    </select>
                  </div>
                </div>
              </div>
              <div class="col-md-4 mb-4">
                <div class="form-group mb-0">
                  <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">Panel Close Hour (24H Format)</label>
                  <div class="f-control">
                    <i class="fas fa-clock mr-3" style="color: var(--muted); font-size: 15px;"></i>
                    <input type="number" name="cutoff_hour" placeholder="e.g. 13 for 1 PM" min="0" max="1000">
                  </div>
                  <small class="form-text text-muted" style="margin-top: 8px; font-size: 12px; font-weight: 600; color: var(--muted) !important;">
                    Ex: seller=13 (1 PM), admin=15 (3 PM), master_admin=17 (5 PM)
                  </small>
                </div>
              </div>
            </div>
            <div class="mt-2">
              <button type="submit" class="btn btn-pro">
                <i class="fas fa-save mr-1"></i> Save
              </button>
            </div>
          </form>
        </div>
      </div>

      <!-- ===== DEACTIVE TIME CARD ===== -->
      <div class="dash-card mb-4" style="border-left: 4px solid var(--danger) !important;">
        <div class="dash-card-head d-flex align-items-center">
          <div class="dash-ico mr-2"><i class="fas fa-hourglass-half" style="color: var(--danger) !important;"></i></div>
          <div>
            <div class="dash-title" style="color: var(--danger) !important;">Key Deactive Time</div>
            <div class="dash-sub">Configure the auto-deactivation grace hours for unpaid/expired keys</div>
          </div>
        </div>
        <div class="dash-card-body">
          <form method="post" action="">
            <div class="row align-items-end">
              <div class="col-md-6 mb-4 mb-md-0">
                <div class="form-group mb-0">
                  <label class="form-label" style="font-weight: 700; color: var(--muted); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 10px; display: block;">Key Deactive Time (Hours)</label>
                  <div class="input-group">
                    <div class="f-control" style="border-radius: 8px 0 0 8px; border-right: none; height: 50px !important; flex: 1;">
                      <i class="fas fa-stopwatch mr-3" style="color: var(--danger); font-size: 15px;"></i>
                      <input type="number" name="grace_hours" value="<%= settings.key_grace_hours %>" min="0" max="720" required style="font-size: 18px; font-weight: 800; color: var(--danger);">
                    </div>
                    <div class="input-group-append">
                      <span class="input-group-text" style="background: var(--danger); color: #fff; border: 2px solid var(--danger); border-radius: 0 8px 8px 0; font-weight: 800; font-size: 14px; display: flex; align-items: center; padding: 0 20px;">HOURS</span>
                    </div>
                  </div>
                  <div class="alert alert-danger mt-3 mb-0" style="background: rgba(239, 68, 68, 0.05); border: 1px solid var(--danger); color: var(--danger); border-radius: 8px; font-weight: 600; font-size: 13.5px; padding: 10px 15px;">
                    <i class="fas fa-info-circle mr-1"></i> Current Setting: <b><%= settings.key_grace_hours %> hours (<%= Math.round(settings.key_grace_hours / 24) %> din)</b> baad key auto-suspend hogi.
                  </div>
                </div>
              </div>
              <div class="col-md-3">
                <button type="submit" class="btn btn-danger w-100" style="height: 50px; font-size: 14px;">
                  <i class="fas fa-bolt mr-1"></i> UPDATE TIMER
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- ===== SMALL PANEL DEACTIVE TIME CARD ===== -->
      <div class="dash-card mb-4" style="border-left: 4px solid var(--accent) !important;">
        <div class="dash-card-head d-flex align-items-center">
          <div class="dash-ico mr-2"><i class="fas fa-users-slash" style="color: var(--accent) !important;"></i></div>
          <div>
            <div class="dash-title" style="color: var(--accent) !important;">Small Panel Deactive Time</div>
            <div class="dash-sub">Configure grace period for downstream child panels</div>
          </div>
        </div>
        <div class="dash-card-body">
          <form method="post" action="">
            <div class="row align-items-center">
              <div class="col-md-7 mb-4 mb-md-0">
                <div class="alert alert-info mb-0" style="background: rgba(59, 130, 246, 0.05); border: 1px solid var(--accent); color: var(--ink); border-radius: 8px; font-weight: 600; font-size: 13.5px; padding: 12px 18px; line-height: 1.5;">
                  <i class="fas fa-info-circle mr-1" style="color: var(--accent);"></i> Agar kisi Developer/Admin ka panel Due ki wajah se band hota hai, to unke neeche ke (Seller, Admin) walo ki keys turant band na ho kar <strong style="color: var(--accent); font-size: 16px;"><%= settings.child_grace_hours %></strong> ghante baad band hongi.
                </div>
              </div>
              <div class="col-md-5">
                <div class="input-group">
                  <div class="f-control" style="border-radius: 8px 0 0 8px; border-right: none; height: 50px !important; flex: 1;">
                    <i class="fas fa-clock mr-3" style="color: var(--accent); font-size: 15px;"></i>
                    <input type="number" name="child_grace_hours" value="<%= settings.child_grace_hours %>" min="0" required style="font-size: 16px; font-weight: 800; color: var(--ink);">
                  </div>
                  <div class="input-group-append">
                    <button class="btn btn-pro" type="submit" style="border-radius: 0 8px 8px 0; height: 50px; font-size: 14px; padding: 0 20px;">
                      UPDATE
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </form>
        </div>
      </div>

      <!-- ===== PRICES LIST TABLE ===== -->
      <div class="dash-card mb-4">
        <div class="dash-card-head d-flex align-items-center">
          <div class="dash-ico mr-2"><i class="fas fa-list-alt" style="color: #10b981 !important;"></i></div>
          <div>
            <div class="dash-title">All Active Panel Price and Time List</div>
            <div class="dash-sub">Role pricing and closure schedules database</div>
          </div>
        </div>
        <div class="dash-card-body p-0">
          <div class="table-responsive">
            <table class="table table-bordered table-striped mb-0">
              <thead>
                <tr>
                  <th>Role Name</th>
                  <th>Price</th>
                  <th>Panel Close Time (IST)</th>
                  <th style="width: 120px; text-align: center;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% priceRows.forEach(function (row) { %>
                  <tr>
                    <td>
                      <b style="font-size: 15px; color: var(--ink); text-transform: capitalize;"><%= row.roleName %></b>
                    </td>
                    <td>
                      <span class="badge-price" style="display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 0.85rem; font-weight: 800; background: rgba(46, 125, 50, 0.15); color: #2e7d32;">&#8377; <%= Number(row.price).toLocaleString('en-IN') %></span>
                    </td>
                    <td>
                      <span class='badge-time' style='display: inline-block; padding: 4px 10px; border-radius: 6px; font-size: 0.8rem; font-weight: 700; background: rgba(245, 158, 11, 0.15); color: #b45309;'><i class='far fa-clock'></i> <%= row.cutoffLabel %></span> <small style='color:var(--muted); font-weight:700; margin-left:8px;'>(Hour: <%= row.cutoffHour %>)</small>
                    </td>
                    <td class="text-center">
                      <a href="/status_update?f_id=<%= row.id %>"
                         class="btn btn-danger btn-sm"
                         style="background: linear-gradient(135deg, #ef4444, #dc2626) !important; color: #fff !important; border: 0 !important; font-weight: 800; border-radius: 6px; padding: 6px 12px;"
                         onclick="return confirm('Kya aap isko delete karna chahte hain?')">
                        <i class="fas fa-trash-alt"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/foot') %>
