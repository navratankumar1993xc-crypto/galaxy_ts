<%- include('../partials/head') %>
<%- include('../partials/topbar') %>
<%- include('../partials/sidebar') %>

<div class="content-wrapper">
  <%- include('../partials/pagehead') %>

  <section class="content">
    <div class="container-fluid">
      <%- include('../partials/flash') %>

      <div class="dash-card">
        <div class="dash-card-head d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center">
            <div class="dash-ico mr-2"><i class="fas fa-images"></i></div>
            <div>
              <div class="dash-title">Today Tickets Images</div>
              <div class="dash-sub">Showing only today's images from tickets3</div>
            </div>
          </div>
        </div>
        <div class="dash-card-body">
          <div class="row" style="gap:10px; margin: 20px;"> <!-- gap set to 10px -->
            <% if (images.length) { %>
              <% images.forEach(function (t) {
                const imageUrl = t.image_file ? '/result_image/' + t.id : '/uploads/' + encodeURIComponent(t.img);
              %>
                <div class="col-6 col-md-3 mb-3">
                  <a href="<%= imageUrl %>" target="_blank" rel="noopener">
                    <img src="<%= imageUrl %>" alt="Ticket <%= t.id %>"
                         style="width: 100%; border-radius: 10px; border: 1px solid var(--line);">
                  </a>
                </div>
              <% }) %>
            <% } else { %>
              <div class='col-12 text-center'><p class='text-muted'>No images found for today.</p></div>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </section>
</div>

<%- include('../partials/foot', { tables: true }) %>
